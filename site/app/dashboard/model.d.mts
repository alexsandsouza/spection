export type Requirement={id:string;text:string;reviewed:boolean};
export type Task={id:string;text:string;status:"todo"|"doing"|"done";requirement:string};
export type Evidence={id:string;requirement:string;test:string;text:string};
export type Workspace={title:string;id?:string;archived?:boolean;docs:Record<string,string>;requirements:Requirement[];tasks:Task[];evidence:Evidence[]};
export const paths:string[];
export function fromDocs(docs:Record<string,string>):Workspace;
export function validate(w:unknown):Workspace;
export function gaps(w:Workspace):Requirement[];
export function slug(name:string):string;
export function uniqueId(list:Workspace[]):string;
export function migrateProjects(input:unknown):Workspace[];
export function sameProject(a:Workspace,b:Workspace):boolean;
export function duplicateProject(projects:Workspace[],candidate:Workspace,skipId?:string):boolean;
